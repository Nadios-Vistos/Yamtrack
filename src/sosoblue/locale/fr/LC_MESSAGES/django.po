msgid "Up next"
msgstr "À suivre"

#: templates/sosoblue/waiting.html:12
msgid "Series you are up to date on, waiting for new episodes."
msgstr ""
"Les séries sur lesquelles vous êtes à jour, en attente de nouveaux épisodes."

#: templates/sosoblue/waiting.html:18
msgid "Refresh statuses"
msgstr "Actualiser les statuts"

#: templates/sosoblue/waiting.html:25
#, python-format
msgid ""
"The status of %(counter)s series has not been fetched yet. It is updated "
"every day, or now with the refresh button."
msgid_plural ""
"The status of %(counter)s series has not been fetched yet. It is updated "
"every day, or now with the refresh button."
msgstr[0] ""
"Le statut de %(counter)s série n'a pas encore été récupéré. Il est mis à "
"jour chaque jour, ou tout de suite avec le bouton d'actualisation."
msgstr[1] ""
"Le statut de %(counter)s séries n'a pas encore été récupéré. Il est mis à "
"jour chaque jour, ou tout de suite avec le bouton d'actualisation."

#: templates/sosoblue/waiting.html:30
msgid "Next episode announced"
msgstr "Prochain épisode annoncé"

#: templates/sosoblue/waiting.html:40
#, python-format
msgid "in %(delay)s"
msgstr "dans %(delay)s"

#: templates/sosoblue/waiting.html:46
msgid "No release date announced for your series yet."
msgstr "Aucune date de sortie annoncée pour vos séries pour l'instant."

#: templates/sosoblue/waiting.html:51
msgid "Coming back, date unknown"
msgstr "Suite confirmée, date inconnue"

#: templates/sosoblue/waiting.html:66
msgid "None of your up-to-date series has been renewed yet."
msgstr "Aucune de vos séries à jour n'a encore été renouvelée."

#: templates/sosoblue/waiting.html:72
msgid "Status not fetched yet"
msgstr "Statut pas encore récupéré"

#: views.py:30
