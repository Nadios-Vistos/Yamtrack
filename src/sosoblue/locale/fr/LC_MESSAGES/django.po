#: templates/sosoblue/history_progress.html:14
msgid "Reading the history…"
msgstr "Lecture de l'historique…"

#: templates/sosoblue/history_progress.html:17
msgid "You can leave this page, it carries on in the background."
msgstr "Vous pouvez quitter cette page, le travail continue en arrière-plan."

